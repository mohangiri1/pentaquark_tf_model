# Figure size
figure.figsize: 5.3, 3.28

# Font Settings
font.family: serif
font.serif: Times New Roman
font.size: 10
text.usetex: False

# Mathtext (so $E(k)$ etc. also in Times New Roman)
mathtext.fontset: custom
mathtext.rm: Times New Roman
mathtext.it: Times New Roman:italic
mathtext.bf: Times New Roman:bold

# =========================================
# Savefig properties
# =========================================
path.simplify: True
savefig.bbox: tight
savefig.pad_inches: 0.05
pdf.fonttype: 42     # Embed TrueType fonts (best for Inkscape)
ps.fonttype: 42
svg.fonttype: none   # Keep text editable in SVG

# Axes properties
axes.titlesize: large
axes.labelsize: 10
axes.formatter.use_mathtext: True
axes.linewidth: 0.8
axes.edgecolor: black

# Grid properties
axes.grid: False
grid.linewidth: 0.8
grid.linestyle: dashed
grid.color: xkcd:light gray

# Line properties
lines.linewidth: 1.5
lines.markersize: 6
hatch.linewidth: 0.25
patch.antialiased: True

# X-axis tick properties
xtick.top: True
xtick.bottom: True
xtick.major.size: 3.0
xtick.minor.size: 1.5
xtick.major.width: 0.8
xtick.minor.width: 0.8
xtick.direction: in
xtick.minor.visible: True
xtick.major.pad: 5.0
xtick.minor.pad: 5.0
xtick.labelsize: 10

# Y-axis tick properties
ytick.left: True
ytick.right: True
ytick.major.size: 3.0
ytick.minor.size: 1.5
ytick.major.width: 0.8
ytick.minor.width: 0.8
ytick.direction: in
ytick.minor.visible: True
ytick.major.pad: 5.0
ytick.minor.pad: 5.0
ytick.labelsize: 10

# Legend properties
legend.frameon: True
legend.fontsize: 10
legend.handlelength: 1.375
legend.labelspacing: 0.4
legend.columnspacing: 1
legend.facecolor: white
legend.edgecolor: black
legend.framealpha: 1
legend.title_fontsize: 10